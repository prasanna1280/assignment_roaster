# ─── Database ────────────────────────────────────────────
# Note: docker-compose overrides DATABASE_URL to point at the `db` service
# (postgresql://roaster:roaster@db:5432/assignment_roaster).
DATABASE_URL=postgresql://user:password@localhost:5432/assignment_roaster

# ─── Auth (email/password sign up + JWT) ─────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth (sign up / login with Google) ──────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── GitHub API (public repos only) ──────────────────────
# Optional but recommended: a fine-grained personal access token with NO extra
# permissions (public read only). Raises GitHub rate limit from 60 to 5,000 req/hour.
GITHUB_TOKEN=

# ─── OpenAI (roast generation) ───────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ─── Roast limits ────────────────────────────────────────
ROAST_DAILY_LIMIT=5
ROAST_MAX_FILES=150
ROAST_MAX_BYTES=200000

# ─── Frontend ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
