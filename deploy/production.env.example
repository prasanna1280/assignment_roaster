# Production settings for docker-compose.prod.yml.
# Copy to .env.production in the repo root on the server (git-ignored) and fill in.

# ─── Domain ──────────────────────────────────────────────
# DNS A record must point to the VPS IP before starting (Caddy gets HTTPS for it).
DOMAIN=roaster.example.com

# ─── Secrets (generate fresh values; never reuse local ones) ──
# openssl rand -hex 24   (hex only: it is embedded in the database URL)
POSTGRES_PASSWORD=
# openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ────────────────────────────────────────
# In Google Cloud add: JavaScript origin https://<DOMAIN>
# and redirect URI https://<DOMAIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub API (optional; fine-grained token with no permissions) ──
GITHUB_TOKEN=

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Roast limits ────────────────────────────────────────
ROAST_DAILY_LIMIT=5
ROAST_MAX_FILES=150
ROAST_MAX_BYTES=200000
